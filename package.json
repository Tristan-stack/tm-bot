{
  "name": "launch-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @launchbot/bot --filter @launchbot/worker --filter @launchbot/webapp dev",
    "build": "tsc -b && pnpm --filter @launchbot/webapp exec vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "cross-env RUN_DB_TESTS=1 vitest run",
    "test:devnet": "cross-env RUN_DEVNET_TESTS=1 vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @launchbot/db db:generate",
    "db:migrate": "pnpm --filter @launchbot/db db:migrate",
    "db:deploy": "pnpm --filter @launchbot/db db:deploy",
    "db:reset": "pnpm --filter @launchbot/db db:reset",
    "db:studio": "pnpm --filter @launchbot/db db:studio",
    "db:seed": "pnpm --filter @launchbot/db db:seed"
  },
  "prettier": {
    "printWidth": 100
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
