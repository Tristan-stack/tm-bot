DEFAULT_TOKEN_IMAGE_URL=        # image utilisée quand le token n'en a pas (V2)
PRIORITY_FEE_MIN_MICROLAMPORTS=0
PRIORITY_FEE_MAX_MICROLAMPORTS=
ADMIN_TELEGRAM_IDS=             # IDs Telegram séparés par des virgules : commandes admin, jamais supprimés pour inactivité
TREASURY_WALLET=
SOL_PRICE_API_URL=              # optionnel : CoinGecko Simple Price par défaut (voir README), cache 60 s
LLM_API_KEY=
IMAGE_API_KEY=

# --- Hors §12 : variables techniques optionnelles (Proposition) ---
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent
# TELEGRAM_API_ID=              # my.telegram.org (API development tools). Pas le BOT_TOKEN
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=             # imprimé au premier lancement de success-source. Ensuite la commande poste les nouvelles cartes de @rugpilotprofits. Ne pas committer.
# API_PORT=3001                 # port local de l'API (le proxy /api de Vite pointe dessus)
# API_HOST=127.0.0.1            # 0.0.0.0 dans un conteneur
# POSTGRES_PORT=5440           # port local publié par docker-compose (pas 5432 : souvent pris par un PostgreSQL natif)
