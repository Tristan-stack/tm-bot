WALLET_ENCRYPTION_KEY=          # 32 octets en base64 (openssl rand -base64 32) — à sauvegarder, jamais changer
WEBAPP_URL=
API_URL=
CHANNEL_BOT_ID=
CHANNEL_BOT_URL=
CHANNEL_SUCCESS_ID=
CHANNEL_SUCCESS_URL=
CHANNEL_ANNOUNCEMENTS_ID=
CHANNEL_ANNOUNCEMENTS_URL=
