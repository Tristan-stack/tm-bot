{
  "name": "@launchbot/worker",
  "version": "0.1.0",
  "private": true,
  "description": "pg-boss jobs: payments, sweeps, reminders, cleanup",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "job": "tsx src/run-job.ts",
    "success-source": "tsx src/read-success-source.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --root ../.. --project worker"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@launchbot/db": "workspace:*",
    "@launchbot/shared": "workspace:*",
    "@launchbot/solana": "workspace:*",
    "grammy": "1.46.0",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "telegram": "2.26.22"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
