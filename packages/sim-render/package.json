{
  "name": "@launchbot/sim-render",
  "version": "0.1.0",
  "private": true,
  "description": "Pictures of the simulation: chart and PNL card built as SVG in TypeScript, rasterized to PNG",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-helpers": "./src/test-helpers.ts"
  },
  "scripts": {
    "dev": "tsc -b --watch --preserveWatchOutput",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --root ../.. --project sim-render",
    "render:sample": "tsx scripts/sample.ts",
    "preview:card": "tsx scripts/preview-card.ts"
  },
  "dependencies": {
    "@launchbot/shared": "workspace:*",
    "@launchbot/sim-engine": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "ffmpeg-static": "5.2.0"
  }
}
