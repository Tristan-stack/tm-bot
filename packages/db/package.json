{
  "name": "@launchbot/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client and shared business services",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test": "./src/test-db.ts"
  },
  "scripts": {
    "dev": "tsc -b --watch --preserveWatchOutput",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --root ../.. --project db",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@launchbot/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.1"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
